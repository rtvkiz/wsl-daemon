set -o pipefail

VERSION="1.0.0"

# =============================================================================
# CONFIGURATION
# =============================================================================

# Config file (user overrides)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wsl-security"
CONFIG_FILE="$CONFIG_DIR/config"

# Data directories
DATA_DIR="$HOME/.local/share/wsl-security"
QUARANTINE_DIR="$DATA_DIR/quarantine"
DB_FILE="$DATA_DIR/security.db"

# Log files
LOG_FILE="$DATA_DIR/daemon.log"
ALERT_FILE="$DATA_DIR/alerts.log"
SCAN_LOG="$DATA_DIR/scan.log"
INFECTION_LOG="$DATA_DIR/infections.log"

# PID files
DAEMON_PID="$DATA_DIR/daemon.pid"
REALTIME_PID="$DATA_DIR/realtime.pid"

# Config files
VT_API_KEY_FILE="$HOME/.config/virustotal-api-key"
VT_API_URL="https://www.virustotal.com/api/v3"

# Scan directories
SCAN_DIRS=("$HOME" "/tmp" "/var/tmp")
WATCH_DIRS=("$HOME/Downloads" "/tmp" "$HOME/Desktop" "$HOME/Documents")
TEMP_DIRS=("/tmp" "$HOME/.cache" "$HOME/Downloads" "$HOME/.local/share/Trash" "/var/tmp")

# Exclude patterns (glob patterns to skip during scans)
EXCLUDE_PATTERNS=("*.log" "*.tmp" "node_modules/*" ".git/*" "__pycache__/*" "*.pyc")

# Max log size before rotation (10MB)
MAX_LOG_SIZE=10485760

# Intervals (seconds)
NETWORK_INTERVAL=900       # 15 minutes
FILE_INTERVAL=21600        # 6 hours
VT_INTERVAL=43200          # 12 hours
QUICK_SCAN_INTERVAL=7200   # 2 hours
FULL_SCAN_INTERVAL=86400   # 24 hours
TEMP_CLEAN_INTERVAL=21600  # 6 hours
SLEEP_INTERVAL=60          # Check every minute

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# Load user config if exists
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# =============================================================================
# HELPER FUNCTIONS
# =============================================================================

# Run parameterized SQL query
# Usage: run_sql "INSERT INTO t (a,b) VALUES (:a,:b)" ":a=val1" ":b=val2"
run_sql() {
    local query="$1"
    shift
    local params=""
    for param in "$@"; do
        params="$params.param set $param
"
    done
    sqlite3 "$DB_FILE" "${params}${query}" 2>/dev/null
}

# Sanitize for PowerShell notifications
sanitize_notify() {
    local str="$1"
    # Remove characters that could break PowerShell strings
    str="${str//\'/}"
    str="${str//\"/}"
    str="${str//\$/}"
    str="${str//\`/}"
    str="${str//\\/}"
    # Limit length
    printf '%s' "${str:0:200}"
}

# Rotate log file if too large
rotate_log() {
    local logfile="$1"
    [[ ! -f "$logfile" ]] && return 0

    local size
    size=$(stat -c%s "$logfile" 2>/dev/null || echo 0)

    if [[ $size -gt $MAX_LOG_SIZE ]]; then
        mv "$logfile" "${logfile}.1" 2>/dev/null
        # Keep only one backup
        rm -f "${logfile}.2" 2>/dev/null
        touch "$logfile"
    fi
}

# Detect package manager
detect_pkg_manager() {
    if command -v apt-get &>/dev/null; then
        echo "apt"
    elif command -v dnf &>/dev/null; then
        echo "dnf"
    elif command -v pacman &>/dev/null; then
        echo "pacman"
    elif command -v zypper &>/dev/null; then
        echo "zypper"
    else
        echo "unknown"
    fi
}

# =============================================================================
# INITIALIZATION
# =============================================================================

init() {
    mkdir -p "$DATA_DIR" "$QUARANTINE_DIR"

    # Initialize SQLite database
    sqlite3 "$DB_FILE" <<'EOF' 2>/dev/null
CREATE TABLE IF NOT EXISTS files (
    path TEXT PRIMARY KEY,
    owner TEXT,
    permissions TEXT,
    size INTEGER,
    first_seen INTEGER,
    last_seen INTEGER,
    suspicious_score INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS system_health (
    timestamp INTEGER PRIMARY KEY,
    memory_used_percent REAL,
    disk_used_percent REAL,
    cpu_load REAL,
    battery_percent REAL,
    battery_status TEXT
);

CREATE TABLE IF NOT EXISTS scans (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER,
    scan_type TEXT,
    files_scanned INTEGER,
    threats_found INTEGER,
    duration INTEGER
);

CREATE TABLE IF NOT EXISTS infections (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER,
    file_path TEXT,
    threat_name TEXT,
    action TEXT,
    hash TEXT
);

CREATE TABLE IF NOT EXISTS quarantine (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER,
    original_path TEXT,
    quarantine_path TEXT,
    threat_name TEXT,
    hash TEXT
);

CREATE INDEX IF NOT EXISTS idx_suspicious ON files(suspicious_score DESC);
CREATE INDEX IF NOT EXISTS idx_last_seen ON files(last_seen DESC);
EOF
}

# =============================================================================
# LOGGING & NOTIFICATIONS
# =============================================================================

log() {
    rotate_log "$LOG_FILE"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG_FILE"
}

log_scan() {
    rotate_log "$SCAN_LOG"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$SCAN_LOG"
}

log_infection() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$INFECTION_LOG"
}

alert() {
    local message="$1"
    log "ALERT: $message"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $message" >> "$ALERT_FILE"
    notify "SECURITY ALERT" "$message"
}

notify() {
    local title
    local message
    title=$(sanitize_notify "$1")
    message=$(sanitize_notify "$2")

    if command -v powershell.exe &>/dev/null; then
        powershell.exe -Command "
        [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > \$null;
        \$Template = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02);
        \$RawXml = [xml] \$Template.GetXml();
        (\$RawXml.toast.visual.binding.text|where {\$_.id -eq '1'}).AppendChild(\$RawXml.CreateTextNode('$title')) > \$null;
        (\$RawXml.toast.visual.binding.text|where {\$_.id -eq '2'}).AppendChild(\$RawXml.CreateTextNode('$message')) > \$null;
        \$SerializedXml = New-Object Windows.Data.Xml.Dom.XmlDocument;
        \$SerializedXml.LoadXml(\$RawXml.OuterXml);
        \$Toast = [Windows.UI.Notifications.ToastNotification]::new(\$SerializedXml);
        \$Toast.Tag = 'WSL';
        \$Toast.Group = 'WSL Security';
        \$Toast.ExpirationTime = [DateTimeOffset]::Now.AddMinutes(5);
        \$Notifier = [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('WSL Security Daemon');
        \$Notifier.Show(\$Toast);
        " 2>/dev/null
    fi
}

# =============================================================================
# SYSTEM HEALTH MONITORING
# =============================================================================

check_system_health() {
    local current_time=$(date +%s)
    local mem_info=$(free | grep Mem)
    local mem_total=$(echo "$mem_info" | awk '{print $2}')
    local mem_used=$(echo "$mem_info" | awk '{print $3}')
    local mem_percent=$(awk "BEGIN {printf \"%.1f\", ($mem_used/$mem_total)*100}")
    local disk_percent=$(df -h "$HOME" | awk 'NR==2 {print $5}' | tr -d '%')
    local cpu_load=$(uptime | awk -F'load average:' '{print $2}' | awk -F, '{print $1}' | xargs)

    local battery_percent="NULL"
    local battery_status="'unknown'"
    if command -v powershell.exe &> /dev/null; then
        local battery_info=$(timeout 2 powershell.exe -Command "Get-CimInstance -ClassName Win32_Battery | Select-Object EstimatedChargeRemaining, BatteryStatus" 2>/dev/null | grep -v "^$" | tail -2 || echo "")
        if [ -n "$battery_info" ]; then
            local bp=$(echo "$battery_info" | head -1 | awk '{print $NF}' | tr -d '\r\n' | grep -E '^[0-9]+$' || echo "")
            [ -n "$bp" ] && battery_percent="$bp"
            local bat_status_code=$(echo "$battery_info" | tail -1 | awk '{print $NF}' | tr -d '\r\n')
            case "$bat_status_code" in
                1) battery_status="'discharging'" ;;
                2) battery_status="'charging'" ;;
                3) battery_status="'full'" ;;
            esac
        fi
    fi

    run_sql "INSERT INTO system_health (timestamp, memory_used_percent, disk_used_percent, cpu_load, battery_percent, battery_status)
        VALUES (:ts, :mem, :disk, :cpu, :bat, :batstat);" \
        ":ts=$current_time" ":mem=$mem_percent" ":disk=$disk_percent" ":cpu=$cpu_load" ":bat=$battery_percent" ":batstat=$battery_status"

    echo "System Health:"
    echo "  Memory: ${mem_percent}%"
    echo "  Disk: ${disk_percent}%"
    echo "  Load: $cpu_load"
    [ "$battery_percent" != "NULL" ] && echo "  Battery: ${battery_percent}%"

    # Check for issues
    local mem_int=$(echo "$mem_percent" | cut -d. -f1)
    [ "$mem_int" -gt 85 ] 2>/dev/null && echo "  High memory usage"
    [ "${disk_percent%.*}" -gt 90 ] 2>/dev/null && echo "  Disk space low"
}

# =============================================================================
# FILE INTEGRITY MONITORING
# =============================================================================

scan_file_anomalies() {
    local current_time=$(date +%s)
    [ ! -f "$DATA_DIR/last_scan" ] && touch -d "7 days ago" "$DATA_DIR/last_scan"

    local suspicious_count=0

    # Check root-owned files in high-risk locations
    for check_dir in "$HOME/Projects" "$HOME/Downloads" "$HOME/Documents"; do
        [ ! -d "$check_dir" ] && continue
        while IFS= read -r file; do
            [ ! -f "$file" ] && continue

            local owner=$(stat -c "%U" "$file" 2>/dev/null)
            local perms=$(stat -c "%a" "$file" 2>/dev/null)
            local size=$(stat -c "%s" "$file" 2>/dev/null || echo 0)

            run_sql "INSERT OR REPLACE INTO files (path, owner, permissions, size, suspicious_score, first_seen, last_seen)
                VALUES (:path, :owner, :perms, :size, 40,
                        COALESCE((SELECT first_seen FROM files WHERE path=:path), :time), :time);" \
                ":path=$file" ":owner=$owner" ":perms=$perms" ":size=$size" ":time=$current_time"
            ((suspicious_count++))
        done < <(find "$check_dir" -maxdepth 3 -type f -user root 2>/dev/null | head -10)
    done

    # Check for setuid/setgid files
    while IFS= read -r file; do
        [ ! -f "$file" ] && continue
        case "$file" in
            */.local/share/containers/*) continue ;;
        esac

        local owner=$(stat -c "%U" "$file" 2>/dev/null)
        local perms=$(stat -c "%a" "$file" 2>/dev/null)
        local size=$(stat -c "%s" "$file" 2>/dev/null || echo 0)

        run_sql "INSERT OR REPLACE INTO files (path, owner, permissions, size, suspicious_score, first_seen, last_seen)
            VALUES (:path, :owner, :perms, :size, 60,
                    COALESCE((SELECT first_seen FROM files WHERE path=:path), :time), :time);" \
            ":path=$file" ":owner=$owner" ":perms=$perms" ":size=$size" ":time=$current_time"
        ((suspicious_count++))
    done < <(find "$HOME" -type f \( -perm -4000 -o -perm -2000 \) ! -path "*/.local/share/containers/*" -newer "$DATA_DIR/last_scan" 2>/dev/null | head -10)

    touch "$DATA_DIR/last_scan"

    # Report suspicious files
    local total_suspicious=$(sqlite3 "$DB_FILE" "SELECT COUNT(*) FROM files WHERE suspicious_score > 35 AND last_seen > $(date -d '7 days ago' +%s);" 2>/dev/null || echo "0")
    if [ "$total_suspicious" -gt 0 ]; then
        echo ""
        echo "Found $total_suspicious suspicious file(s):"
        sqlite3 -separator '|' "$DB_FILE" "SELECT substr(path, 1, 60), suspicious_score FROM files WHERE suspicious_score > 35 AND last_seen > $(date -d '7 days ago' +%s) ORDER BY suspicious_score DESC LIMIT 5;" 2>/dev/null | while IFS='|' read -r path score; do
            echo "  [Score: $score] $path"
        done
    else
        echo ""
        echo "No file anomalies detected"
    fi
}

# =============================================================================
# NETWORK MONITORING
# =============================================================================

check_network() {
    echo ""
    echo "Network Monitoring:"

    local suspicious_connections=()
    local connection_count=0

    if command -v ss &> /dev/null; then
        connections=$(ss -tn state established 2>/dev/null | awk 'NR>1 {print $4, $5}' || echo "")
    else
        connections=$(netstat -tn 2>/dev/null | grep ESTABLISHED | awk '{print $4, $5}' || echo "")
    fi

    if [ -n "$connections" ]; then
        while read -r local remote; do
            [ -z "$remote" ] && continue
            remote_ip=$(echo "$remote" | cut -d: -f1-4 | sed 's/:$//')
            remote_port=$(echo "$remote" | rev | cut -d: -f1 | rev)

            case "$remote_ip" in
                127.*|localhost|::1|169.254.*|192.168.*|10.*|172.16.*|172.17.*|172.18.*|172.19.*|172.2[0-9].*|172.3[0-1].*|fe80:*)
                    continue
                    ;;
            esac

            local suspicious=0
            case "$remote_port" in
                1337|31337|4444|5555|6666|6667|7777|8888|9999|12345|54321|65535)
                    suspicious=1 ;;
                6660|6661|6662|6663|6664|6665|6668|6669)
                    suspicious=1 ;;
            esac

            if [ $suspicious -eq 1 ]; then
                suspicious_connections+=("$remote_ip:$remote_port (suspicious port)")
            fi
            ((connection_count++))
        done <<< "$connections"

        echo "  Active connections: $connection_count"

        if [ ${#suspicious_connections[@]} -gt 0 ]; then
            echo "  Suspicious network connections:"
            for conn in "${suspicious_connections[@]}"; do
                echo "    - $conn"
            done
        fi

        local top_ip=$(echo "$connections" | awk '{print $2}' | cut -d: -f1-4 | sed 's/:$//' | grep -v '^127\.' | grep -v '^192\.168\.' | grep -v '^10\.' | grep -v '^172\.' | grep -v '^$' | sort | uniq -c | sort -rn | head -1)
        if [ -n "$top_ip" ]; then
            local conn_count=$(echo "$top_ip" | awk '{print $1}')
            local ip_addr=$(echo "$top_ip" | awk '{print $2}')
            if [ -n "$ip_addr" ] && [ "$conn_count" -gt 10 ]; then
                echo "  High connection count to $ip_addr: $conn_count connections"
            fi
        fi
    else
        echo "  No external connections detected"
    fi
}

# =============================================================================
# VIRUSTOTAL INTEGRATION
# =============================================================================

vt_get_api_key() {
    [ -f "$VT_API_KEY_FILE" ] && cat "$VT_API_KEY_FILE"
}

vt_check_hash() {
    local hash="$1"
    local api_key="$2"
    curl -s --request GET --url "${VT_API_URL}/files/${hash}" --header "x-apikey: ${api_key}" 2>/dev/null
}

vt_scan_file() {
    local file="$1"
    local api_key=$(vt_get_api_key)

    if [ -z "$api_key" ]; then
        echo "ERROR: No VirusTotal API key found"
        echo "Setup: $0 vt-setup"
        return 1
    fi

    [ ! -f "$file" ] && return 1

    echo "Checking: $file"
    local hash=$(sha256sum "$file" | awk '{print $1}')
    echo "  SHA256: $hash"

    local response=$(vt_check_hash "$hash" "$api_key")

    if echo "$response" | grep -q '"error"'; then
        echo -e "  ${YELLOW}Status: Not found in VirusTotal database${NC}"
        return 0
    fi

    local malicious=$(echo "$response" | grep -o '"malicious":[0-9]*' | grep -o '[0-9]*' | head -1)
    local suspicious=$(echo "$response" | grep -o '"suspicious":[0-9]*' | grep -o '[0-9]*' | head -1)
    local total=$(echo "$response" | grep -o '"total":[0-9]*' | grep -o '[0-9]*' | head -1)

    if [ -n "$malicious" ] && [ "$malicious" -gt 0 ]; then
        echo -e "  ${RED}MALWARE DETECTED: ${malicious}/${total} engines${NC}"
        return 2
    elif [ -n "$suspicious" ] && [ "$suspicious" -gt 0 ]; then
        echo -e "  ${YELLOW}Suspicious: ${suspicious}/${total} engines${NC}"
        return 1
    else
        echo -e "  ${GREEN}Clean: 0/${total} detections${NC}"
        return 0
    fi
}

vt_batch_scan() {
    local api_key=$(vt_get_api_key)
    [ -z "$api_key" ] && { echo "No VirusTotal API key configured"; return 1; }

    echo "VirusTotal Batch Scan"
    echo "====================="

    local files=$(sqlite3 "$DB_FILE" "SELECT path FROM files WHERE suspicious_score > 40 ORDER BY suspicious_score DESC LIMIT 5;" 2>/dev/null)
    [ -z "$files" ] && { echo "No suspicious files to scan"; return 0; }

    local count=0
    while IFS= read -r file; do
        [ ! -f "$file" ] && continue
        ((count++))
        echo ""
        vt_scan_file "$file"
        [ $count -lt 5 ] && sleep 15
    done <<< "$files"
}

vt_check_network() {
    local api_key=$(vt_get_api_key)
    [ -z "$api_key" ] && { echo "No VirusTotal API key"; return 1; }

    echo "VirusTotal Network Check"
    echo "========================"

    local connections=""
    if command -v ss &> /dev/null; then
        connections=$(ss -tn state established 2>/dev/null | awk 'NR>1 {print $5}' | cut -d: -f1-4 | sed 's/:$//' || echo "")
    fi

    local unique_ips=$(echo "$connections" | grep -vE '^127\.|^192\.168\.|^10\.|^172\.' | sort -u | head -5)
    [ -z "$unique_ips" ] && { echo "No external IPs to check"; return 0; }

    local checked=0
    while IFS= read -r ip; do
        [ -z "$ip" ] && continue
        echo "Checking IP: $ip"
        local response=$(curl -s --request GET --url "${VT_API_URL}/ip-addresses/${ip}" --header "x-apikey: ${api_key}" 2>/dev/null)
        local malicious=$(echo "$response" | grep -o '"malicious":[0-9]*' | grep -o '[0-9]*' | head -1)

        if [ -n "$malicious" ] && [ "$malicious" -gt 0 ]; then
            echo -e "  ${RED}MALICIOUS: ${malicious} vendors flagged${NC}"
        else
            echo -e "  ${GREEN}Clean${NC}"
        fi
        ((checked++))
        [ $checked -lt 5 ] && sleep 15
    done <<< "$unique_ips"
}

vt_setup() {
    echo "VirusTotal Setup"
    echo "================"
    echo ""
    echo "1. Get your free API key: https://www.virustotal.com/gui/join-us"
    echo ""
    echo "2. Enter your API key:"
    read -r api_key

    if [ -n "$api_key" ]; then
        mkdir -p "$(dirname "$VT_API_KEY_FILE")"
        echo "$api_key" > "$VT_API_KEY_FILE"
        chmod 600 "$VT_API_KEY_FILE"
        echo -e "${GREEN}API key saved${NC}"
    else
        echo "No API key provided"
        return 1
    fi
}

# =============================================================================
# ANTIVIRUS ENGINE (ClamAV)
# =============================================================================

av_check_clamav() {
    command -v clamscan &> /dev/null
}

av_install_clamav() {
    echo "Installing ClamAV..."
    local pkg_mgr
    pkg_mgr=$(detect_pkg_manager)

    case "$pkg_mgr" in
        apt)
            sudo apt-get update && sudo apt-get install -y clamav clamav-daemon
            ;;
        dnf)
            sudo dnf install -y clamav clamav-update clamd
            ;;
        pacman)
            sudo pacman -Sy --noconfirm clamav
            ;;
        zypper)
            sudo zypper install -y clamav
            ;;
        *)
            echo -e "${RED}Unsupported package manager. Install clamav manually.${NC}"
            return 1
            ;;
    esac

    sudo systemctl stop clamav-freshclam 2>/dev/null || true
    echo "Downloading virus signatures..."
    sudo freshclam
    sudo systemctl start clamav-freshclam 2>/dev/null || true
    echo -e "${GREEN}ClamAV installed${NC}"
}

av_update_signatures() {
    av_check_clamav || { echo "ClamAV not installed"; return 1; }
    echo "Updating virus signatures..."
    sudo systemctl stop clamav-freshclam 2>/dev/null || true
    sudo freshclam && echo -e "${GREEN}Signatures updated${NC}"
    sudo systemctl start clamav-freshclam 2>/dev/null || true
}

av_quarantine_file() {
    local file="$1"
    local threat="$2"
    [ ! -f "$file" ] && return 1

    local hash=$(sha256sum "$file" 2>/dev/null | awk '{print $1}')
    local timestamp=$(date +%s)
    local basename=$(basename "$file")
    local quarantine_file="$QUARANTINE_DIR/${timestamp}_${basename}.quarantine"

    if mv "$file" "$quarantine_file" 2>/dev/null; then
        chmod 000 "$quarantine_file"
        run_sql "INSERT INTO quarantine (timestamp, original_path, quarantine_path, threat_name, hash)
            VALUES (:ts, :orig, :qpath, :threat, :hash);" \
            ":ts=$timestamp" ":orig=$file" ":qpath=$quarantine_file" ":threat=$threat" ":hash=$hash"
        log_infection "QUARANTINED: $file -> $quarantine_file (Threat: $threat)"
        echo -e "${YELLOW}Quarantined: $file${NC}"
        return 0
    else
        log_infection "QUARANTINE FAILED: $file (Threat: $threat)"
        chmod 000 "$file" 2>/dev/null
        return 1
    fi
}

av_scan_directory() {
    local dir="$1"
    local scan_type="${2:-full}"
    [ ! -d "$dir" ] && return 1

    log_scan "Starting $scan_type scan: $dir"
    echo -e "${BLUE}Scanning: $dir${NC}"

    local start_time=$(date +%s)
    local files_scanned=0
    local threats_found=0

    if av_check_clamav; then
        local scan_output=$(clamscan -r -i --bell "$dir" 2>/dev/null)
        files_scanned=$(echo "$scan_output" | grep "Scanned files" | grep -oE '[0-9]+' || echo "0")
        local infected=$(echo "$scan_output" | grep "Infected files" | grep -oE '[0-9]+' || echo "0")
        threats_found=$infected

        if [ "$infected" -gt 0 ]; then
            echo -e "${RED}$infected threat(s) found!${NC}"
            while IFS= read -r line; do
                local file=$(echo "$line" | sed 's/: .*//')
                local threat=$(echo "$line" | sed 's/.*: \(.*\) FOUND/\1/')
                [ -f "$file" ] && av_quarantine_file "$file" "$threat"
            done < <(echo "$scan_output" | grep "FOUND")
        fi
    else
        echo "ClamAV not installed. Run: $0 av-install"
    fi

    local end_time=$(date +%s)
    local duration=$((end_time - start_time))

    run_sql "INSERT INTO scans (timestamp, scan_type, files_scanned, threats_found, duration)
        VALUES (:ts, :type, :files, :threats, :dur);" \
        ":ts=$start_time" ":type=$scan_type" ":files=$files_scanned" ":threats=$threats_found" ":dur=$duration"

    echo -e "${GREEN}Scan complete${NC}"
    echo "  Files: $files_scanned | Threats: $threats_found | Duration: ${duration}s"

    [ $threats_found -gt 0 ] && notify "VIRUS ALERT" "$threats_found threat(s) detected!"
}

av_quick_scan() {
    log_scan "=== Quick Scan Started ==="
    for dir in "$HOME/Downloads" "/tmp" "$HOME/.cache"; do
        [ -d "$dir" ] && av_scan_directory "$dir" "quick"
    done
}

av_full_scan() {
    log_scan "=== Full Scan Started ==="
    for dir in "${SCAN_DIRS[@]}"; do
        [ -d "$dir" ] && av_scan_directory "$dir" "full"
    done
}

# =============================================================================
# REAL-TIME SCANNER
# =============================================================================

rt_check_inotify() {
    command -v inotifywait &> /dev/null
}

rt_install_inotify() {
    echo "Installing inotify-tools..."
    local pkg_mgr
    pkg_mgr=$(detect_pkg_manager)

    case "$pkg_mgr" in
        apt)
            sudo apt-get update && sudo apt-get install -y inotify-tools
            ;;
        dnf)
            sudo dnf install -y inotify-tools
            ;;
        pacman)
            sudo pacman -Sy --noconfirm inotify-tools
            ;;
        zypper)
            sudo zypper install -y inotify-tools
            ;;
        *)
            echo -e "${RED}Unsupported package manager. Install inotify-tools manually.${NC}"
            return 1
            ;;
    esac
    echo -e "${GREEN}inotify-tools installed${NC}"
}

rt_quick_hash_check() {
    local file="$1"
    local hash=$(sha256sum "$file" 2>/dev/null | awk '{print $1}')
    [ -f "$DATA_DIR/malware_hashes.txt" ] && grep -q "^$hash$" "$DATA_DIR/malware_hashes.txt" 2>/dev/null && return 1
    return 0
}

rt_scan_file() {
    local file="$1"
    [ ! -f "$file" ] && return 0

    local size=$(stat -c%s "$file" 2>/dev/null || echo "0")
    [ "$size" -lt 50 ] && return 0
    [ "$size" -gt 52428800 ] && return 0

    case "${file##*.}" in
        txt|log|md|json|xml|csv|yml|yaml|gitignore|dockerignore) return 0 ;;
    esac

    log "RT-Scan: $file"

    if ! rt_quick_hash_check "$file"; then
        log "KNOWN MALWARE HASH: $file"
        av_quarantine_file "$file" "Known malware signature"
        notify "VIRUS DETECTED" "Known malware in ${file##*/}"
        return 1
    fi

    if av_check_clamav; then
        local result=$(timeout 5 clamscan --no-summary --max-filesize=50M "$file" 2>/dev/null)
        if echo "$result" | grep -q "FOUND"; then
            local threat=$(echo "$result" | grep "FOUND" | sed 's/.*: \(.*\) FOUND/\1/')
            log "THREAT: $file ($threat)"
            av_quarantine_file "$file" "$threat"
            notify "VIRUS DETECTED" "$threat in ${file##*/}"
            return 1
        fi
    fi
    return 0
}

rt_start() {
    rt_check_inotify || { echo "inotify-tools not installed. Run: $0 rt-install"; return 1; }

    if [ -f "$REALTIME_PID" ]; then
        local old_pid=$(cat "$REALTIME_PID")
        kill -0 "$old_pid" 2>/dev/null && { echo "Real-time scanner already running (PID: $old_pid)"; return 0; }
    fi

    echo $$ > "$REALTIME_PID"
    echo -e "${GREEN}Real-time scanner started${NC}"
    echo "Monitoring:"
    for dir in "${WATCH_DIRS[@]}"; do
        [ -d "$dir" ] && echo "  - $dir"
    done

    trap "log 'Real-time scanner stopped'; rm -f '$REALTIME_PID'; exit 0" SIGTERM SIGINT EXIT

    local watch_cmd="inotifywait -m -r -e close_write,moved_to"
    for dir in "${WATCH_DIRS[@]}"; do
        [ -d "$dir" ] && watch_cmd="$watch_cmd $dir"
    done

    $watch_cmd 2>/dev/null | while read -r directory event filename; do
        rt_scan_file "${directory}${filename}"
    done
}

rt_stop() {
    if [ -f "$REALTIME_PID" ]; then
        local pid=$(cat "$REALTIME_PID")
        kill -0 "$pid" 2>/dev/null && kill "$pid"
        rm -f "$REALTIME_PID"
        echo -e "${GREEN}Real-time scanner stopped${NC}"
    else
        echo "Real-time scanner not running"
    fi
}

rt_status() {
    if [ -f "$REALTIME_PID" ]; then
        local pid=$(cat "$REALTIME_PID")
        if kill -0 "$pid" 2>/dev/null; then
            echo -e "${GREEN}Real-time scanner running (PID: $pid)${NC}"
            return 0
        fi
    fi
    echo -e "${YELLOW}Real-time scanner not running${NC}"
    return 1
}

# =============================================================================
# TEMP CLEANUP
# =============================================================================

clean_temp() {
    echo -e "${BLUE}Cleaning temporary files...${NC}"
    local total_cleaned=0
    local space_freed=0

    for temp_dir in "${TEMP_DIRS[@]}"; do
        [ ! -d "$temp_dir" ] || [ ! -r "$temp_dir" ] && continue

        local size_before=$(du -sb "$temp_dir" 2>/dev/null | cut -f1 || echo "0")
        local count=0

        while IFS= read -r file; do
            rm -f "$file" 2>/dev/null && ((count++))
        done < <(find "$temp_dir" -type f -mtime +7 -user "$USER" 2>/dev/null)

        find "$temp_dir" -type d -empty -user "$USER" -delete 2>/dev/null

        local size_after=$(du -sb "$temp_dir" 2>/dev/null | cut -f1 || echo "0")
        local freed=$((size_before - size_after))
        local freed_mb=$((freed / 1024 / 1024))

        [ $count -gt 0 ] && echo "  $(basename "$temp_dir"): $count files, ${freed_mb}MB freed"
        ((total_cleaned += count))
        ((space_freed += freed))
    done

    # Clean old database entries
    sqlite3 "$DB_FILE" "DELETE FROM files WHERE last_seen < $(date -d '30 days ago' +%s);" 2>/dev/null
    sqlite3 "$DB_FILE" "DELETE FROM system_health WHERE timestamp < $(date -d '30 days ago' +%s);" 2>/dev/null
    sqlite3 "$DB_FILE" "VACUUM;" 2>/dev/null

    local total_mb=$((space_freed / 1024 / 1024))
    echo -e "${GREEN}Cleanup complete: $total_cleaned files, ${total_mb}MB freed${NC}"
}

# =============================================================================
# MAIN DAEMON
# =============================================================================

daemon_start() {
    if [ -f "$DAEMON_PID" ]; then
        local old_pid=$(cat "$DAEMON_PID")
        if kill -0 "$old_pid" 2>/dev/null; then
            echo -e "${YELLOW}Daemon already running (PID: $old_pid)${NC}"
            return 0
        fi
    fi

    echo "Starting WSL Security Daemon..."

    (
        echo $BASHPID > "$DAEMON_PID"

        trap "log 'Daemon stopping...'; rm -f '$DAEMON_PID'; exit 0" SIGTERM SIGINT EXIT

        log "=== WSL Security Daemon Started (PID: $BASHPID) ==="

        # Start real-time scanner in background
        if rt_check_inotify; then
            nohup "$0" rt-start >/dev/null 2>&1 &
            log "Real-time scanner started"
        fi

        LAST_NETWORK_CHECK=0
        LAST_FILE_CHECK=0
        LAST_VT_SCAN=0
        LAST_QUICK_SCAN=0
        LAST_FULL_SCAN=0
        LAST_TEMP_CLEAN=0

        while true; do
            CURRENT_TIME=$(date +%s)

            # Network monitoring
            if [ $((CURRENT_TIME - LAST_NETWORK_CHECK)) -ge $NETWORK_INTERVAL ]; then
                log "Starting network check..."
                NETWORK_RESULT=$(check_network 2>&1)
                echo "$NETWORK_RESULT" | grep -q "Suspicious\|MALWARE" && alert "Suspicious network activity detected"

                if [ -f "$VT_API_KEY_FILE" ]; then
                    vt_check_network 2>&1 | tee -a "$LOG_FILE" | grep -q "malicious" && alert "Malicious IP connection detected"
                fi
                LAST_NETWORK_CHECK=$CURRENT_TIME
            fi

            # File integrity check
            if [ $((CURRENT_TIME - LAST_FILE_CHECK)) -ge $FILE_INTERVAL ]; then
                log "Starting file integrity scan..."
                FILE_RESULT=$(check_system_health 2>&1; scan_file_anomalies 2>&1)
                echo "$FILE_RESULT" | grep -q "suspicious\|MALWARE\|High memory\|Disk space" && alert "System health issue detected"
                LAST_FILE_CHECK=$CURRENT_TIME
            fi

            # VirusTotal scan
            if [ $((CURRENT_TIME - LAST_VT_SCAN)) -ge $VT_INTERVAL ] && [ -f "$VT_API_KEY_FILE" ]; then
                log "Starting VirusTotal scan..."
                VT_RESULT=$(vt_batch_scan 2>&1)
                echo "$VT_RESULT" | grep -q "MALWARE DETECTED" && alert "VirusTotal detected malware"
                LAST_VT_SCAN=$CURRENT_TIME
            fi

            # Quick antivirus scan
            if [ $((CURRENT_TIME - LAST_QUICK_SCAN)) -ge $QUICK_SCAN_INTERVAL ]; then
                log "Starting quick AV scan..."
                av_quick_scan 2>&1 | tee -a "$LOG_FILE" | grep -q "Threats found: [1-9]" && alert "Quick scan found malware"
                LAST_QUICK_SCAN=$CURRENT_TIME
            fi

            # Full antivirus scan
            if [ $((CURRENT_TIME - LAST_FULL_SCAN)) -ge $FULL_SCAN_INTERVAL ]; then
                log "Starting full AV scan..."
                av_full_scan 2>&1 | tee -a "$LOG_FILE" | grep -q "Threats found: [1-9]" && alert "Full scan found malware"
                LAST_FULL_SCAN=$CURRENT_TIME
            fi

            # Temp cleanup
            if [ $((CURRENT_TIME - LAST_TEMP_CLEAN)) -ge $TEMP_CLEAN_INTERVAL ]; then
                log "Starting temp cleanup..."
                clean_temp >> "$LOG_FILE" 2>&1
                LAST_TEMP_CLEAN=$CURRENT_TIME
            fi

            # Ensure real-time scanner is running
            if [ $((CURRENT_TIME % 300)) -eq 0 ] && rt_check_inotify; then
                if [ ! -f "$REALTIME_PID" ] || ! kill -0 "$(cat "$REALTIME_PID" 2>/dev/null)" 2>/dev/null; then
                    log "Restarting real-time scanner..."
                    nohup "$0" rt-start >/dev/null 2>&1 &
                fi
            fi

            # Hourly heartbeat
            [ $((CURRENT_TIME % 3600)) -eq 0 ] && log "Daemon heartbeat - operational"

            sleep $SLEEP_INTERVAL
        done
    ) &

    disown
    sleep 2

    if [ -f "$DAEMON_PID" ] && kill -0 "$(cat "$DAEMON_PID")" 2>/dev/null; then
        echo -e "${GREEN}Daemon started (PID: $(cat "$DAEMON_PID"))${NC}"
        echo ""
        echo "Schedule:"
        echo "  Network checks: Every 15 minutes"
        echo "  File integrity: Every 6 hours"
        echo "  Quick AV scan:  Every 2 hours"
        echo "  Full AV scan:   Every 24 hours"
        echo "  Temp cleanup:   Every 6 hours"
    else
        echo -e "${RED}Failed to start daemon${NC}"
        return 1
    fi
}

daemon_stop() {
    echo "Stopping WSL Security Daemon..."

    rt_stop 2>/dev/null

    if [ -f "$DAEMON_PID" ]; then
        local pid=$(cat "$DAEMON_PID")
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid"
            sleep 1
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
            rm -f "$DAEMON_PID"
            echo -e "${GREEN}Daemon stopped${NC}"
        else
            rm -f "$DAEMON_PID"
            echo "Daemon was not running"
        fi
    else
        echo "Daemon is not running"
    fi
}

daemon_status() {
    echo "=== WSL Security Daemon Status ==="
    echo ""

    # Main daemon
    if [ -f "$DAEMON_PID" ] && kill -0 "$(cat "$DAEMON_PID" 2>/dev/null)" 2>/dev/null; then
        echo -e "Main Daemon:      ${GREEN}Running${NC} (PID: $(cat "$DAEMON_PID"))"
    else
        echo -e "Main Daemon:      ${RED}Stopped${NC}"
    fi

    # Real-time scanner
    if [ -f "$REALTIME_PID" ] && kill -0 "$(cat "$REALTIME_PID" 2>/dev/null)" 2>/dev/null; then
        echo -e "Real-time Scan:   ${GREEN}Running${NC} (PID: $(cat "$REALTIME_PID"))"
    else
        echo -e "Real-time Scan:   ${YELLOW}Stopped${NC}"
    fi

    # ClamAV
    if av_check_clamav; then
        echo -e "ClamAV:           ${GREEN}Installed${NC}"
    else
        echo -e "ClamAV:           ${YELLOW}Not installed${NC}"
    fi

    # VirusTotal
    if [ -f "$VT_API_KEY_FILE" ]; then
        echo -e "VirusTotal:       ${GREEN}Configured${NC}"
    else
        echo -e "VirusTotal:       ${YELLOW}Not configured${NC}"
    fi

    # inotify
    if rt_check_inotify; then
        echo -e "inotify-tools:    ${GREEN}Installed${NC}"
    else
        echo -e "inotify-tools:    ${YELLOW}Not installed${NC}"
    fi

    echo ""

    # Recent activity
    if [ -f "$LOG_FILE" ]; then
        echo "Recent Activity:"
        tail -5 "$LOG_FILE" | sed 's/^/  /'
    fi

    # Alerts
    if [ -f "$ALERT_FILE" ] && [ -s "$ALERT_FILE" ]; then
        local alert_count=$(wc -l < "$ALERT_FILE")
        echo ""
        echo -e "${YELLOW}$alert_count alert(s) logged${NC}"
        echo "Recent:"
        tail -3 "$ALERT_FILE" | sed 's/^/  /'
    fi

    # Quarantine
    local qcount=$(ls -1 "$QUARANTINE_DIR" 2>/dev/null | wc -l)
    [ "$qcount" -gt 0 ] && echo -e "\n${YELLOW}$qcount file(s) in quarantine${NC}"
}

# =============================================================================
# DASHBOARD
# =============================================================================

show_dashboard() {
    clear
    echo -e "${BOLD}${CYAN}"
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║           WSL Security Daemon - Dashboard                    ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"

    daemon_status

    echo ""
    echo -e "${BOLD}Last Scan Results:${NC}"
    sqlite3 -header -column "$DB_FILE" "SELECT
        datetime(timestamp, 'unixepoch', 'localtime') as 'Date',
        scan_type as 'Type',
        files_scanned as 'Files',
        threats_found as 'Threats'
        FROM scans ORDER BY timestamp DESC LIMIT 5;" 2>/dev/null || echo "  No scans yet"

    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  $0 start    - Start daemon"
    echo "  $0 scan     - Run quick scan now"
    echo "  $0 status   - Show status"
}

# =============================================================================
# QUARANTINE MANAGEMENT
# =============================================================================

show_quarantine() {
    echo "=== Quarantine ==="
    echo ""

    if [ -z "$(ls -A "$QUARANTINE_DIR" 2>/dev/null)" ]; then
        echo "No files in quarantine"
        return 0
    fi

    sqlite3 -header -column "$DB_FILE" "SELECT
        id,
        datetime(timestamp, 'unixepoch', 'localtime') as 'Date',
        original_path as 'Original Path',
        threat_name as 'Threat'
        FROM quarantine ORDER BY timestamp DESC;" 2>/dev/null

    echo ""
    echo "Total: $(ls -1 "$QUARANTINE_DIR" 2>/dev/null | wc -l) file(s)"
}

# =============================================================================
# MAIN ENTRY POINT
# =============================================================================

init

case "${1:-help}" in
    # Version
    -v|--version|version)
        echo "WSL Security Daemon v$VERSION"
        exit 0
        ;;

    # Daemon control
    start)           daemon_start ;;
    stop)            daemon_stop ;;
    restart)         daemon_stop; sleep 2; daemon_start ;;
    status)          daemon_status ;;
    dashboard)       show_dashboard ;;

    # Scanning
    scan)            [ -n "$2" ] && av_scan_directory "$2" "custom" || av_quick_scan ;;
    quick-scan)      av_quick_scan ;;
    full-scan)       av_full_scan ;;

    # Real-time scanner
    rt-start)        rt_start ;;
    rt-stop)         rt_stop ;;
    rt-status)       rt_status ;;
    rt-install)      rt_install_inotify ;;

    # Antivirus
    av-install)      av_install_clamav ;;
    av-update)       av_update_signatures ;;

    # VirusTotal
    vt-setup)        vt_setup ;;
    vt-scan)         [ -n "$2" ] && vt_scan_file "$2" || vt_batch_scan ;;
    vt-network)      vt_check_network ;;

    # System checks
    health)          check_system_health; scan_file_anomalies ;;
    network)         check_network ;;
    clean)           clean_temp ;;

    # Logs and alerts
    logs)            tail -n "${2:-50}" "$LOG_FILE" ;;
    tail)            tail -f "$LOG_FILE" ;;
    alerts)          cat "$ALERT_FILE" 2>/dev/null || echo "No alerts" ;;
    clear-alerts)    > "$ALERT_FILE"; echo "Alerts cleared" ;;

    # Quarantine
    quarantine)      show_quarantine ;;

    # Help
    help|*)
        echo -e "${BOLD}WSL Security Daemon v${VERSION}${NC}"
        echo "Unified security & health monitoring for WSL"
        echo ""
        echo -e "${BOLD}Usage:${NC} $0 <command> [args]"
